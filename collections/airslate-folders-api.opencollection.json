{
  "opencollection": "1.0.0",
  "info": {
    "name": "airSlate signNow REST Document Fields Folders API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signnow.com/folder"
          },
          "docs": "List folders"
        },
        {
          "info": {
            "name": "List documents in folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signnow.com/folder/:folder_id",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List documents in folder"
        }
      ]
    }
  ],
  "bundled": true
}